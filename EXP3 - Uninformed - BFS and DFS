2. BREADTH-FIRST SEARCH (BFS)

from collections import deque

def bfs(graph, start, goal):
queue = deque([[start]])
visited = set([start])

```
while queue:
    path = queue.popleft()
    node = path[-1]

    if node == goal:
        return path

    for neighbor in graph.get(node, []):
        if neighbor not in visited:
            visited.add(neighbor)
            queue.append(path + [neighbor])

return None
