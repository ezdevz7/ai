def h(state, goal):
# Calculate Manhattan distance
distance = 0

```
for i in range(9):
    if state[i] != 0:
        j = goal.index(state[i])

        distance += abs(i // 3 - j // 3)
        distance += abs(i % 3 - j % 3)

return distance
```

def get_neighbors(state):
neighbors = []

```
zero = state.index(0)
row = zero // 3
col = zero % 3

moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

for dr, dc in moves:
    r = row + dr
    c = col + dc

    if 0 <= r < 3 and 0 <= c < 3:
        new = state[:]
        new_zero = r * 3 + c

        new[zero], new[new_zero] = new[new_zero], new[zero]

        neighbors.append(new)

return neighbors
```

def astar(start, goal):
open_list = [(h(start, goal), 0, start, [start])]
visited = []

```
while open_list:
    open_list.sort()
    f, g, state, path = open_list.pop(0)

    if state == goal:
        return path

    if state in visited:
